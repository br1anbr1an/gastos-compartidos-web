# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to git

# PostgreSQL
POSTGRES_USER=gastos_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=shared_expenses_db

# Backend - must match postgres credentials above
DATABASE_URL=postgresql://gastos_user:change_this_password@db/shared_expenses_db

# Frontend port (change if 8080 is taken)
APP_PORT=8080

# Docker Hub (only needed for CI/CD via GitHub Actions)
# DOCKERHUB_USERNAME and DOCKERHUB_TOKEN are set as GitHub repo secrets, not here
