# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to git

# PostgreSQL
POSTGRES_USER=gastos_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=shared_expenses_db

# Backend - must match postgres credentials above
DATABASE_URL=postgresql://gastos_user:change_this_password@db/shared_expenses_db

# JWT Secret Key - generate a strong random key (e.g. openssl rand -hex 32)
SECRET_KEY=change_this_to_a_strong_random_secret

# Tu usuario de GitHub (usado para las imágenes en ghcr.io)
GHCR_OWNER=tu_usuario_de_github

# Ports exposed on the host machine
APP_PORT=9090       # Frontend: http://homelab-ip:9090
BACKEND_PORT=8000   # Backend API direct: http://homelab-ip:8000 (opcional, para debugging)
